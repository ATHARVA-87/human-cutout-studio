# Copy to .env for local development:  cp .env.example .env   (.env is never committed)
# Every app setting uses the SEGMENTATION_ prefix. A real environment variable overrides this file.

# Local PostgreSQL started by `docker compose up db -d`
SEGMENTATION_DATABASE_URL=postgresql+psycopg://segmentation:segmentation@localhost:5432/segmentation
SEGMENTATION_CHECKPOINT_PATH=backend/weights/model.pth
SEGMENTATION_STORAGE_DIR=uploads
SEGMENTATION_MAX_UPLOAD_BYTES=10485760
# true only when the site is served over HTTPS (production)
SEGMENTATION_COOKIE_SECURE=false
# Rate limit: 10 jobs per user, refilled over 30 minutes
SEGMENTATION_BUCKET_CAPACITY=10
SEGMENTATION_BUCKET_PERIOD_SECONDS=1800

# Docker build only: where to download the trained weights when backend/weights/model.pth is missing
MODEL_URL=https://huggingface.co/ATHARVA-87/human-cutout-unet/resolve/main/model.pth
