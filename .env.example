# Copy to .env for local development:  cp .env.example .env   (.env is never committed)
# Every app setting uses the SEGMENTATION_ prefix. A real environment variable overrides this file.

# Local PostgreSQL started by `docker compose up db -d`
SEGMENTATION_DATABASE_URL=postgresql+psycopg://segmentation:segmentation@localhost:5432/segmentation
SEGMENTATION_MODEL_PATH=backend/weights/model.onnx
SEGMENTATION_STORAGE_DIR=uploads
SEGMENTATION_MAX_UPLOAD_BYTES=10485760
# true only when the site is served over HTTPS (production)
SEGMENTATION_COOKIE_SECURE=false
# Rate limit: 10 jobs per user, refilled over 30 minutes
SEGMENTATION_BUCKET_CAPACITY=10
SEGMENTATION_BUCKET_PERIOD_SECONDS=1800
# Uploads, results and history are deleted after this many days (cleanup runs at startup + hourly)
SEGMENTATION_RETENTION_DAYS=5
SEGMENTATION_CLEANUP_INTERVAL_MINUTES=60
# Failed sign-ins allowed per email within the window before HTTP 429
SEGMENTATION_LOGIN_MAX_FAILURES=5
SEGMENTATION_LOGIN_WINDOW_MINUTES=15
# Per-IP abuse limits and the secret used to hash client IPs (set a random value in production)
SEGMENTATION_REGISTRATIONS_PER_IP_PER_DAY=3
SEGMENTATION_LOGIN_FAILURES_PER_IP=20
SEGMENTATION_IP_HASH_SALT=local-development-only

# Email links (verification, password reset) point here. For `npm run dev` use http://localhost:5173
SEGMENTATION_PUBLIC_URL=http://localhost:8000
# Emails go to the local Mailpit inbox (start it with `docker compose up db mailpit -d`, open http://localhost:8025).
# "console" writes them to the log instead. Production uses "brevo" (see render.yaml).
SEGMENTATION_EMAIL_BACKEND=smtp
SEGMENTATION_SMTP_HOST=localhost
SEGMENTATION_SMTP_PORT=1025
SEGMENTATION_EMAIL_FROM=no-reply@example.com

# Docker build only: where to download the trained weights when backend/weights/model.onnx is missing
MODEL_URL=https://huggingface.co/SUPER-87/human-cutout-unet/resolve/main/model.onnx
